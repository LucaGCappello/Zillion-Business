# Zillion Business — environment variables
#
# This is a static HTML/CSS/JS site deployed on Netlify. The only
# server-side code is the Outdoor lead function below.

# ---- Netlify Function: netlify/functions/outdoor-lead.js ----
# Where campaign submissions get forwarded (e.g. an n8n workflow that
# emails the team / logs to a sheet / pushes to a CRM). If this is left
# unset, campaign submissions still work and return a reference number,
# but the lead is NOT persisted anywhere — set this before real launch.
OUTDOOR_CRM_WEBHOOK_URL=

# ---- Client-side config: js/outdoor/config.js ----
# Not read from here automatically (this file has no build step) — the
# WhatsApp number is hardcoded in js/outdoor/config.js. Kept here too so
# it isn't missed during setup. Digits only, with country + area code.
# NEXT_PUBLIC_WHATSAPP_NUMBER is the conventional name if this project
# ever gains a build step; for now, edit js/outdoor/config.js directly.
NEXT_PUBLIC_WHATSAPP_NUMBER=5573900000000
